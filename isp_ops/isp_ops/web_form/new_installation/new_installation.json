 "client_script": "frappe.web_form.after_load = () => {\n    // 1. Find the main container where Frappe renders the web form\n    let formContainer = document.querySelector('.web-form-page') || document.querySelector('.web-form-wrapper form');\n\n    if (!formContainer) {\n        frappe.msgprint(\"Error: Could not load the custom photo uploader.\");\n        return;\n    }\n\n    // 2. Create a new div element for our uploader\n    let uploaderDiv = document.createElement('div');\n    uploaderDiv.innerHTML = `\n        <div style=\"padding: 15px; background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 8px; margin: 20px 0;\">\n            <label style=\"font-weight: bold; margin-bottom: 10px; display: block;\">Attach Multiple Photos</label>\n            \n            <input type=\"file\" id=\"multi-photo-input\" multiple accept=\"image/*\" style=\"display: block; margin-bottom: 15px;\">\n            \n            <button type=\"button\" id=\"btn-upload-photos\" style=\"padding: 8px 16px; background: #0284c7; color: white; border: none; border-radius: 6px; cursor: pointer;\">\n                Upload Photos Now\n            </button>\n            \n            <div id=\"upload-status\" style=\"margin-top: 10px; font-size: 13px; color: #16a34a;\"></div>\n        </div>\n    `;\n\n    // 3. Inject it at the bottom of the form fields\n    formContainer.appendChild(uploaderDiv);\n\n    // 4. Attach the upload logic to the newly injected button\n    document.getElementById('btn-upload-photos').addEventListener('click', function() {\n        let files = document.getElementById('multi-photo-input').files;\n        let statusDiv = document.getElementById('upload-status');\n        \n        if (files.length === 0) {\n            frappe.msgprint(\"Please select photos first.\");\n            return;\n        }\n\n        // --- UPDATED LOGIC FOR URL PARSING ---\n        // Grab the document name from the URL path (e.g., /new-installation/INST-YYYY-MM-00001)\n        const pathArray = window.location.pathname.split('/');\n        \n        // .pop() gets the very last part of the URL (\"INST-YYYY-MM-00001\")\n        // We do it twice with an OR to safely handle trailing slashes just in case\n        let docnameFromUrl = pathArray.pop() || pathArray.pop(); \n        \n        // Use Frappe's native web form doc name if available, otherwise fallback to the URL path we extracted\n        const docname = frappe.web_form.doc.name || docnameFromUrl; \n        \n        // --- UPDATED DOCTYPE ---\n        const doctype = \"Installation Request\"; \n\n        if (!docname || docname === \"new\") {\n            frappe.msgprint(\"Cannot upload: Missing ticket ID.\");\n            return;\n        }\n\n        statusDiv.innerHTML = \"Uploading...\";\n\n        // Loop and upload\n        Array.from(files).forEach(file => {\n            let formData = new FormData();\n            formData.append(\"file\", file, file.name);\n            formData.append(\"doctype\", doctype);\n            formData.append(\"docname\", docname);\n            formData.append(\"is_private\", 0); // 0 = public, 1 = private\n\n            fetch('/api/method/upload_file', {\n                method: 'POST',\n                headers: {\n                    'X-Frappe-CSRF-Token': frappe.csrf_token\n                },\n                body: formData\n            })\n            .then(response => response.json())\n            .then(data => {\n                if(data.message && data.message.file_url) {\n                    statusDiv.innerHTML += `<br>\u2705 Uploaded: ${file.name}`;\n                }\n            })\n            .catch(error => {\n                console.error('Upload failed', error);\n                statusDiv.innerHTML += `<br>\u274c Failed: ${file.name}`;\n            });\n        });\n        \n        // Clear the input after triggering the uploads\n        document.getElementById('multi-photo-input').value = \"\";\n    });\n};",
